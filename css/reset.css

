/* ==========================================================
   Gesture Synth AI
   reset.css
========================================================== */

/* ========= Universal ========= */

*,
*::before,
*::after{

    margin:0;
    padding:0;

    box-sizing:border-box;

}

/* ========= HTML ========= */

html{

    width:100%;

    height:100%;

    scroll-behavior:smooth;

    -webkit-text-size-adjust:100%;

}

/* ========= BODY ========= */

body{

    width:100%;

    min-height:100vh;

    overflow:hidden;

    background:var(--bg-primary);

    color:var(--text-primary);

    font-family:var(--font-main);

    line-height:1.5;

    text-rendering:optimizeLegibility;

    -webkit-font-smoothing:antialiased;

    -moz-osx-font-smoothing:grayscale;

}

/* ========= Media ========= */

img,
picture,
svg,
canvas,
video{

    display:block;

    max-width:100%;

}

/* ========= Form ========= */

button,
input,
textarea,
select{

    font:inherit;

    outline:none;

    border:none;

}

/* ========= Button ========= */

button{

    cursor:pointer;

    background:none;

}

/* ========= Links ========= */

a{

    color:inherit;

    text-decoration:none;

}

/* ========= Lists ========= */

ul,
ol{

    list-style:none;

}

/* ========= Table ========= */

table{

    border-collapse:collapse;

    border-spacing:0;

}

/* ========= Selection ========= */

::selection{

    background:var(--cyan);

    color:#000;

}

/* ========= Scrollbar ========= */

::-webkit-scrollbar{

    width:10px;

    height:10px;

}

::-webkit-scrollbar-track{

    background:#0a0f18;

}

::-webkit-scrollbar-thumb{

    background:rgba(0,243,255,.35);

    border-radius:999px;

}

::-webkit-scrollbar-thumb:hover{

    background:rgba(0,243,255,.65);

}

/* ========= Focus ========= */

:focus-visible{

    outline:2px solid var(--cyan);

    outline-offset:3px;

}

/* ========= Hidden ========= */

.hidden{

    display:none !important;

}

/* ========= Disable Selection ========= */

.no-select{

    user-select:none;

    -webkit-user-select:none;

}

/* ========= Utility ========= */

.center{

    display:flex;

    justify-content:center;

    align-items:center;

}

.flex{

    display:flex;

}

.column{

    flex-direction:column;

}

.row{

    flex-direction:row;

}

/* ========= Fade ========= */

.fade{

    transition:opacity .35s ease;

}

/* ========= Prevent Drag ========= */

img,
video{

    -webkit-user-drag:none;

}